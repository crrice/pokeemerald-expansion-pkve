# Mom's TV broadcast: page Mom's text, watch Norman's scripted battle replay,
# return to the house and get control back. Run once per gender.
variant gender=boy  house=MAP_LITTLEROOT_TOWN_BRENDANS_HOUSE_1F
variant gender=girl house=MAP_LITTLEROOT_TOWN_MAYS_HOUSE_1F

use lib/new_game_to_tv.replay gender=$gender
expect var VAR_LITTLEROOT_INTRO_STATE == 6                     # clock set, broadcast not seen yet
watch replay-ran battle-type has BATTLE_TYPE_SCRIPTED and in-battle

# Mom's lines and "Watch the broadcast?" (YES is the default)
tap A when script-running until in-battle timeout 3000
expect battle-type has BATTLE_TYPE_SCRIPTED

# Norman's replay (src/data/scripted_battles.h). The comeback hinges on Mummy:
# Crunch gives Mightyena Mummy, Slaking's Return catches it, so Truant never kicks in.
tap A when in-battle until battler player hp > 0 and battler opponent hp > 0 timeout 1200
record-battle start
expect battler player species == SPECIES_MIGHTYENA and battler opponent species == SPECIES_COFAGRIGUS
tap A when in-battle until battler opponent species == SPECIES_SLAKING timeout 6000
expect battler player ability == ABILITY_MUMMY                     # caught Mummy from Crunch
tap A when in-battle until battler player species == SPECIES_HARIYAMA timeout 6000
expect battler opponent ability == ABILITY_MUMMY                   # Truant replaced: Slaking acts twice
tap A when in-battle until battle-outcome != 0 timeout 6000
expect battle-outcome == B_OUTCOME_LOST                            # the challenger (player side) lost

# The replay ends and returns to the field
tap A when in-battle until !in-battle and callback2 == CB2_Overworld timeout 30000
record-battle stop
expect-logged "turn 1 player MIGHTYENA uses CRUNCH"
expect-logged "opponent COFAGRIGUS faints"
expect-not-logged "COFAGRIGUS uses"
expect-text "Could that lazy"
expect-logged "turn 2 opponent SLAKING uses RETURN"
expect-logged "player MIGHTYENA faints"
expect-logged "turn 3 opponent SLAKING uses RETURN"
expect-not-logged "HARIYAMA uses"
expect-logged "player HARIYAMA faints"
expect-text "stunning comeback"
expect-transcript golden/norman_tv_battle.log

# Mom's follow-up lines, then the scene releases the player
tap A when script-running until field-idle for 30 timeout 3000

expect-seen replay-ran
expect map == $house
expect flag FLAG_SYS_TV_HOME
expect var VAR_LITTLEROOT_INTRO_STATE == 7
expect party-count == 0                                         # the real (empty) party was restored
expect-control                                                  # control really is back
expect map == $house
